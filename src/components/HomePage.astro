---
import Layout from './Layout.astro';
import { getEntry } from 'astro:content';
import copy from '../content/portfolio-home.json';
const { lang='ru', profile='' } = Astro.props;
const ru = lang === 'ru';
const c = ru ? copy.ru : copy.en;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const catalog = base + '/showcase' + (ru ? '/' : '/en/');
const projects = (await getEntry('showcase', 'projects_' + lang))?.data.projects ?? [];
const picks = ['stalex-feed','tara-bergman','seo-dashboard','regional-seo-metadata','medicine-data','wellland-facets','78-dosok'].flatMap(slug => projects.filter(p => p.slug === slug));
const contacts = [
  {label:'Telegram · @wporgru',url:'https://t.me/wporgru'},
  {label:'zakaz@wp.org.ru',url:'mailto:zakaz@wp.org.ru'},
  {label:'+7 (831) 291-36-31',url:'tel:+78312913631'},
  {label:'Kwork',url:'https://kwork.ru/user/wporgru'},
  {label:'GitHub',url:'https://github.com/wporgru'},
  {label:'WP.ORG.RU',url:'https://wp.org.ru/contacts/'},
];
const skillTags = [
  ['JavaScript','React','Astro','HTML','CSS',ru?'Адаптивная вёрстка':'Responsive design', 'Elementor', 'WoodMart'],
  ['PHP','WordPress','WooCommerce','Directus','REST API','InSales','PHP 8'],
  ['Python','Node.js','SQLite','XML','XLSX',ru?'Парсинг':'Web scraping','WP All Import','1С',ru?'Нормализация данных':'Data normalization'],
  ['Codex','Antigravity',ru?'Агентные сценарии':'Agent workflows',ru?'Редактура AI-контента':'AI content editing',ru?'Проверка результатов ИИ':'AI output validation'],
  ['Yandex Webmaster','Metrica','Google Search Console','IndexNow',ru?'Технический аудит':'Technical audits','Canonical','Sitemap','301 redirects'],
  ['Git','GitHub Actions','Playwright',ru?'Миграция сайтов':'Site migrations',ru?'Тестовый стенд':'Staging',ru?'План отката':'Rollback planning'],
];
const commerceTags = ['YooKassa','CDEK',ru?'Платёжные сценарии':'Payment flows',ru?'Фильтры каталога':'Catalog filters',ru?'Товарные фиды':'Product feeds',ru?'Партнёрские витрины':'Affiliate storefronts'];
const seoTags = ['Rank Math','Yoast SEO','Screaming Frog','GA4',ru?'Аудит метаданных':'Metadata audits',ru?'Региональные поддомены':'Regional subdomains'];
const roleLinks = c.roles.map(([label],i)=>({label,href:'#role-'+(i+1)}));
const person = {name:ru?'Олег Тишин':'Oleg Tishin',jobTitle:c.h1,email:'zakaz@wp.org.ru',sameAs:contacts.filter(x=>x.url.startsWith('https')).map(x=>x.url)};
---
<Layout title={c.title} description={c.description} lang={lang} profile={profile} section="main" personJsonLd={person} roleLinks={roleLinks}>
<section class="container cv-home">
  <div class="page-grid cv-grid">
    <div class="main-content cv-main">
      <article class="card hero">
        <div class="hero__top">
          <div>
            <h1 class="hero__name">{person.name} — {ru ? 'веб-разработчик' : 'web developer'}</h1>
            <p class="hero__title">{ru ? 'Full-stack · E-commerce · Автоматизация и ИИ' : 'Full-stack · E-commerce · Automation and AI'}</p>
            <p class="hero__summary">{c.description} {ru ? 'Более 15 лет в веб-разработке.' : 'Over 15 years in web development.'}</p>
          </div>
        </div>
        <div class="hero__contacts">
          <div class="section__title">{ru ? 'Контакты' : 'Contacts'}</div>
          <div class="pillrow">{contacts.map(x=><a class="pill" href={x.url}>{x.label}</a>)}</div>
        </div>
      </article>

      <article class="card card--achievements">
        <h2 class="h2">{ru ? 'Достижения' : 'Achievements'}</h2>
        <ul class="list">
          <li>{ru ? '582 выполненных заказа в собранном архиве Kwork; 371 отзыв сохранён со скриншотом.' : '582 completed orders in the collected Kwork archive; 371 reviews archived with screenshots.'}</li>
          {c.results.map(([title,body])=><li><strong>{title}.</strong> {body}</li>)}
        </ul>
      </article>

      <section class="section section--experience">
        <h2 class="h2">{ru ? 'Опыт' : 'Experience'}</h2>
        <div class="stack">
          {c.experience.map(([title,body])=>{
            const [name,period]=title.split(' · ');
            return <article class="card item">
              <div class="item__top"><strong>{name}</strong><span class="muted">{period}</span></div>
              <ul class="list"><li>{body}</li></ul>
            </article>;
          })}
        </div>
      </section>

      <section class="section cv-extra">
        <h2 class="h2">{c.rolesTitle}</h2>
        <div class="stack">{c.roles.map(([title,body],i)=><article class="card item" id={'role-'+(i+1)}><h3 class="h2">{title}</h3><p class="muted">{body}</p></article>)}</div>
      </section>

      <section class="section cv-extra">
        <h2 class="h2">{c.workTitle}</h2>
        <div class="stack">{picks.map(p=><article class="card item"><h3 class="h2"><a href={base+'/showcase/'+p.slug+(ru?'/':'/en/')}>{p.name}</a></h3><p class="muted">{p.description}</p></article>)}</div>
        <p><a class="btn btn--ghost" href={catalog}>{c.all} →</a></p>
      </section>
    </div>

    <aside class="sidebar cv-sidebar">
      <article class="card card--downloads">
        <h2 class="h2">{ru ? 'Проекты и связь' : 'Projects and contact'}</h2>
        <div class="btnrow"><a class="btn" href={catalog}>{ru ? 'Проекты' : 'Projects'}</a><a class="btn btn--ghost" href="https://t.me/wporgru">Telegram</a></div>
      </article>
      <article class="card card--skills">
        <h2 class="h2">{ru ? 'Навыки' : 'Skills'}</h2>
        <div class="skillsgrid">{c.skills.map(([group],i)=><div class="skillsgroup">
          <div class="skillsgroup__title">{group}</div>
          <ul class="tags">{skillTags[i].map(tag=><li class="tag">{tag}</li>)}</ul>
        </div>)}<div class="skillsgroup">
          <div class="skillsgroup__title">{ru?'Интернет-магазины и интеграции':'Commerce and integrations'}</div>
          <ul class="tags">{commerceTags.map(tag=><li class="tag">{tag}</li>)}</ul>
        </div><div class="skillsgroup">
          <div class="skillsgroup__title">{ru?'Поисковый аудит и оптимизация':'Search auditing and optimization'}</div>
          <ul class="tags">{seoTags.map(tag=><li class="tag">{tag}</li>)}</ul>
        </div></div>
      </article>
    </aside>
  </div>
</section>
</Layout>
<style>
.cv-home{padding-block:16px 32px}
.cv-grid :global([id^="role-"]){scroll-margin-top:85px}
@media(min-width:960px){
  .cv-sidebar{grid-column:1;grid-row:1}
  .cv-main{grid-column:2;grid-row:1;min-width:0}
}
@media(max-width:959px){
  .cv-grid .hero{order:0}
  .cv-grid .cv-extra{order:6}
}
</style>
