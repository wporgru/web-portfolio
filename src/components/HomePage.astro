---
import Layout from './Layout.astro';
import { getEntry } from 'astro:content';
import copy from '../content/portfolio-home.json';
const { lang='ru', profile='' } = Astro.props;
const ru = lang === 'ru';
const c = ru ? copy.ru : copy.en;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const catalog = base + '/showcase' + (ru ? '/' : '/en/');
const projects = (await getEntry('showcase', 'projects_' + lang))?.data.projects ?? [];
const picks = ['stalex-feed','tara-bergman','seo-dashboard','medicine-data','wellland-facets','78-dosok'].flatMap(slug => projects.filter(p => p.slug === slug));
const contacts = [
  {label:'Telegram · @wporgru',url:'https://t.me/wporgru'},
  {label:'zakaz@wp.org.ru',url:'mailto:zakaz@wp.org.ru'},
  {label:'+7 (831) 291-36-31',url:'tel:+78312913631'},
  {label:'Kwork',url:'https://kwork.ru/user/wporgru'},
  {label:'GitHub',url:'https://github.com/wporgru'},
  {label:'WP.ORG.RU',url:'https://wp.org.ru/contacts/'},
];
const person = {name:ru?'Олег Тишин':'Oleg Tishin',jobTitle:c.h1,email:'zakaz@wp.org.ru',sameAs:contacts.filter(x=>x.url.startsWith('https')).map(x=>x.url)};
---
<Layout title={c.title} description={c.description} lang={lang} profile={profile} section="main" personJsonLd={person}>
<div class="container portfolio">
  <section class="intro">
    <p class="kicker">WP.ORG.RU / {c.label}</p>
    <h1>{c.h1}</h1>
    <p class="identity">{person.name} <span>·</span> {c.identity}</p>
    <p class="lede">{c.description}</p>
    <div class="actions"><a class="btn" href="https://t.me/wporgru">{c.cta}</a><a class="btn btn--ghost" href={catalog}>{c.all}</a></div>
    <dl class="proof">{c.stats.map(([number,label])=><div><dt>{number}</dt><dd>{label}</dd></div>)}</dl>
  </section>

  <section id="roles"><h2>{c.rolesTitle}</h2><div class="tiles">
    {c.roles.map(([title,body])=><article><h3>{title}</h3><p>{body}</p></article>)}
  </div></section>
  <section id="work"><h2>{c.workTitle}</h2><div class="tiles">
    {picks.map(p => <article><small>{p.stack.slice(0,3).join(' / ')}</small><h3><a href={base+'/showcase/'+p.slug+(ru?'/':'/en/')}>{p.name}</a></h3><p>{p.description}</p></article>)}
  </div><p><a class="btn btn--ghost" href={catalog}>{c.all} →</a></p></section>
  <section id="results"><h2>{c.resultsTitle}</h2><ul class="timeline">{c.results.map(([title,body])=><li><strong>{title}</strong><p>{body}</p></li>)}</ul></section>
  <section id="experience"><h2>{c.experienceTitle}</h2><div class="tiles">{c.experience.map(([title,body])=><article><h3>{title}</h3><p>{body}</p></article>)}</div></section>
  <section id="skills"><h2>{c.skillsTitle}</h2><div class="tiles">{c.skills.map(([title,body])=><article><h3>{title}</h3><p>{body}</p></article>)}</div></section>
  <section id="contact" class="contact"><h2>{c.contactTitle}</h2><p>{c.contactText}</p><p>{c.hours}</p><div class="actions">{contacts.map(x=><a class="btn btn--ghost" href={x.url}>{x.label}</a>)}</div></section>
</div>
</Layout>
<style>
.portfolio{padding-block:clamp(36px,7vw,90px);max-width:1120px}.portfolio section+section{margin-top:clamp(42px,7vw,82px)}
.kicker,small{color:#a6dafa;letter-spacing:.08em;font-weight:650}.intro h1{font-size:clamp(2.15rem,6vw,4.8rem);line-height:1.05;max-width:21ch;margin:.25em 0}.identity{font-size:clamp(1.08rem,2vw,1.45rem);font-weight:650}.identity span{color:#83c8f1}.lede{font-size:clamp(1.05rem,2.2vw,1.35rem);max-width:58ch}.actions{display:flex;flex-wrap:wrap;gap:.65rem;margin-block:1.25rem}.proof,.tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:1rem}.proof div,article,.contact{border:1px solid var(--border);background:var(--card,rgba(255,255,255,.055));border-radius:16px;padding:1.2rem}.proof dt{font-size:1.65rem;font-weight:750}.proof dd{margin:.3rem 0 0;color:var(--muted)}h2{font-size:clamp(1.6rem,4vw,2.5rem);margin:0 0 1rem}h3{font-size:1.12rem;margin:.4rem 0 .6rem}article p,.timeline p,.contact p{margin:.35rem 0;color:var(--muted);line-height:1.6}.timeline{padding-left:1.3rem}.timeline li+li{margin-top:1rem}a:focus-visible{outline:2px solid #9de5ff;outline-offset:4px}
</style>
