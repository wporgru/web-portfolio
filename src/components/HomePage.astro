---
import Layout from './Layout.astro';
import { getEntry } from 'astro:content';
import copy from '../content/portfolio-home.json';
import { services } from '../content/services.mjs';
const { lang='ru', profile='', downloadUrls } = Astro.props;
const ru = lang === 'ru';
const c = ru ? copy.ru : copy.en;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const catalog = base + '/showcase' + (ru ? '/' : '/en/');
const projects = (await getEntry('showcase', 'projects_' + lang))?.data.projects ?? [];
const picks = ['stalex-feed','tara-bergman','seo-dashboard','arenda-pm-home-performance','medicine-data','wellland-facets','78-dosok'].flatMap(slug => projects.filter(p => p.slug === slug));
const contacts = [
  {label:'Telegram · @wporgru',url:'https://t.me/wporgru'},
  {label:'zakaz@wp.org.ru',url:'mailto:zakaz@wp.org.ru'},
  {label:'+7 (831) 291-36-31',url:'tel:+78312913631'},
  {label:'Kwork',url:'https://kwork.ru/user/wporgru'},
  {label:'GitHub',url:'https://github.com/wporgru'},
  {label:'WP.ORG.RU',url:'https://wp.org.ru/contacts/'},
];
const skillTags = [
  ['JavaScript','React','Astro','HTML','CSS',ru?'Адаптивная вёрстка':'Responsive design', 'Elementor', 'WoodMart'],
  ['PHP','WordPress','WooCommerce','Directus','REST API','InSales','PHP 8'],
  ['Python','Node.js','SQLite','XML','XLSX',ru?'Парсинг':'Web scraping','WP All Import','1С',ru?'Нормализация данных':'Data normalization'],
  ['Codex','Antigravity',ru?'Агентные сценарии':'Agent workflows',ru?'Постановка задач агентам':'Agent task design',ru?'Ограничение действий агента':'Agent action boundaries',ru?'Разбор кода и данных с ИИ':'AI-assisted code and data analysis',ru?'Редактура AI-контента':'AI content editing',ru?'Проверка результатов ИИ':'AI output validation'],
  ['Yandex Webmaster','Metrica','Google Search Console','IndexNow',ru?'Технический аудит':'Technical audits','Canonical','Sitemap','301 redirects'],
  ['Git','GitHub Actions','Playwright',ru?'Миграция сайтов':'Site migrations',ru?'Тестовый стенд':'Staging',ru?'Диагностика PHP и плагинов':'PHP and plugin diagnostics',ru?'Браузерные регрессии':'Browser regression testing',ru?'План отката':'Rollback planning'],
];
const commerceTags = ['YooKassa','CDEK',ru?'Платёжные сценарии':'Payment flows',ru?'Фильтры каталога':'Catalog filters',ru?'Глобальные атрибуты':'Global product attributes',ru?'Вариативные товары':'Product variations',ru?'Проверка остатков из 1С':'1C stock validation',ru?'Товарные фиды':'Product feeds',ru?'Партнёрские витрины':'Affiliate storefronts'];
const seoTags = ['Rank Math','Yoast SEO','Screaming Frog','GA4',ru?'Аудит метаданных':'Metadata audits',ru?'Региональные поддомены':'Regional subdomains',ru?'Цели покупки в Яндекс Метрике':'Yandex Metrica purchase goals'];
const localizationTags = [ru?'Испанская локализация':'Spanish localization',ru?'Португалоязычные сайты':'Portuguese-language websites',ru?'Мультиязычные меню':'Multilingual navigation',ru?'Выбор города':'City selection',ru?'Сохранение региона в cookie':'Cookie-based region preferences'];
const orderTags = [ru?'Транзакционные письма':'Transactional email',ru?'Статусы заказов':'Order statuses',ru?'Подарки по сумме корзины':'Cart-based gift rules',ru?'Тестирование форм бронирования':'Booking form testing'];
const mediaTags = ['WebP','XnView',ru?'Оптимизация медиатеки WordPress':'WordPress media optimization',ru?'ИИ-увеличение изображений':'AI image upscaling'];
const roleLinks = c.roles.map(([label],i)=>({label,href:'#role-'+(i+1)}));
const roleServices = ['website-redesign','catalog-automation','data-and-ai','technical-seo'].map(slug=>services.find(service=>service.slug===slug)!);
const person = {name:ru?'Олег Тишин':'Oleg Tishin',jobTitle:c.h1,email:'zakaz@wp.org.ru',sameAs:contacts.filter(x=>x.url.startsWith('https')).map(x=>x.url)};
---
<Layout title={c.title} description={c.description} lang={lang} profile={profile} section="main" personJsonLd={person} roleLinks={roleLinks}>
<section class="container cv-home">
  <div class="page-grid cv-grid">
    <div class="main-content cv-main">
      <article class="card hero">
        <div class="hero__top">
          <div>
            <h1 class="hero__name">{person.name} — {ru ? 'веб-разработчик' : 'web developer'}</h1>
            <p class="hero__title">{ru ? 'Full-stack · E-commerce · Автоматизация и ИИ' : 'Full-stack · E-commerce · Automation and AI'}</p>
            <p class="hero__summary">{c.description} {ru ? 'Более 15 лет в веб-разработке.' : 'Over 15 years in web development.'}</p>
          </div>
        </div>
        <div class="hero__contacts">
          <div class="section__title">{ru ? 'Контакты' : 'Contacts'}</div>
          <div class="pillrow">{contacts.map(x=><a class="pill" href={x.url}>{x.label}</a>)}</div>
        </div>
      </article>

      <article class="card card--achievements">
        <h2 class="h2">{ru ? 'Достижения' : 'Achievements'}</h2>
        <ul class="list">
          <li>{ru ? '582 выполненных заказа в собранном архиве Kwork; 371 отзыв сохранён со скриншотом.' : '582 completed orders in the collected Kwork archive; 371 reviews archived with screenshots.'}</li>
          {c.results.map(([title,body])=><li><strong>{title}.</strong> {body}</li>)}
          <li><a href={base+'/showcase/arenda-pm-home-performance/'+(ru?'':'en/')}><strong>PageSpeed 72 → 96</strong></a> — {ru?'мобильная главная Аренда-ПМ: LCP 6,8 → 2,7 с в лабораторных замерах.':'Arenda-PM mobile homepage: LCP 6.8 → 2.7 s in lab measurements.'}</li>
          <li><a href={base+'/showcase/bgtgroup-technical-seo-performance/'+(ru?'':'en/')}><strong>BGT Group: PageSpeed 37 → 86</strong></a> — {ru?'мобильный лабораторный замер; на компьютере 63 → 92.':'mobile lab measurement; desktop 63 → 92.'}</li>
        </ul>
      </article>

      <section class="section section--experience">
        <h2 class="h2">{ru ? 'Опыт' : 'Experience'}</h2>
        <div class="stack">
          {c.experience.map(([title,body])=>{
            const [name,period]=title.split(' · ');
            return <article class="card item">
              <div class="item__top"><strong>{name}</strong><span class="muted">{period}</span></div>
              <ul class="list"><li>{body}</li></ul>
            </article>;
          })}
        </div>
      </section>

      <section class="section cv-extra">
        <h2 class="h2">{c.rolesTitle}</h2>
        <div class="stack">{c.roles.map(([title,body],i)=><article class="card item" id={'role-'+(i+1)}>
          <h3 class="h2">{title}</h3>
          <p class="muted">{body}</p>
          <a class="pill" href={base+'/services/'+roleServices[i].slug+(ru?'/':'/en/')}>{roleServices[i][ru?'ru':'en'][0]}</a>
        </article>)}</div>
      </section>

      <section class="section cv-extra">
        <h2 class="h2">{c.workTitle}</h2>
        <div class="stack">{picks.map(p=><article class="card item"><h3 class="h2"><a href={base+'/showcase/'+p.slug+(ru?'/':'/en/')}>{p.name}</a></h3><p class="muted">{p.description}</p></article>)}</div>
        <p><a class="btn btn--ghost" href={catalog}>{c.all} →</a></p>
      </section>
    </div>

    <aside class="sidebar cv-sidebar">
      <article class="card card--downloads">
        <h2 class="h2">{ru ? 'Скачать' : 'Download'}</h2>
        <div class="skillsgroup__title">{ru ? 'Людям' : 'For people'}</div>
        <div class="btnrow">
          <a class="btn" href={downloadUrls.pdf} download aria-label={ru ? 'Скачать резюме PDF' : 'Download resume PDF'}>PDF</a>
          <a class="btn btn--ghost" href={downloadUrls.docx} download aria-label={ru ? 'Скачать резюме DOCX' : 'Download resume DOCX'}>DOCX</a>
        </div>
        <div class="skillsgroup__title">{ru ? 'Для ATS' : 'For ATS'}</div>
        <div class="btnrow">
          <a class="btn btn--ghost" href={downloadUrls.pdfAts} download aria-label={ru ? 'Скачать одноколоночное резюме PDF для ATS' : 'Download single-column ATS resume PDF'}>PDF</a>
          <a class="btn btn--ghost" href={downloadUrls.txt} download aria-label={ru ? 'Скачать текстовое резюме TXT' : 'Download plain text resume'}>TXT</a>
        </div>
      </article>
      <article class="card card--skills">
        <h2 class="h2">{ru ? 'Навыки' : 'Skills'}</h2>
        <div class="skillsgrid">{c.skills.map(([group],i)=><div class="skillsgroup">
          <div class="skillsgroup__title">{group}</div>
          <ul class="tags">{skillTags[i].map(tag=><li class="tag">{tag}</li>)}</ul>
        </div>)}<div class="skillsgroup">
          <div class="skillsgroup__title">{ru?'Интернет-магазины и интеграции':'Commerce and integrations'}</div>
          <ul class="tags">{commerceTags.map(tag=><li class="tag">{tag}</li>)}</ul>
        </div><div class="skillsgroup">
          <div class="skillsgroup__title">{ru?'Поисковый аудит и оптимизация':'Search auditing and optimization'}</div>
          <ul class="tags">{seoTags.map(tag=><li class="tag">{tag}</li>)}</ul>
        </div><div class="skillsgroup">
          <div class="skillsgroup__title">{ru?'Локализация и региональные сайты':'Localization and regional websites'}</div>
          <ul class="tags">{localizationTags.map(tag=><li class="tag">{tag}</li>)}</ul>
        </div><div class="skillsgroup">
          <div class="skillsgroup__title">{ru?'Заказы, уведомления и акции':'Orders, notifications and promotions'}</div>
          <ul class="tags">{orderTags.map(tag=><li class="tag">{tag}</li>)}</ul>
        </div><div class="skillsgroup">
          <div class="skillsgroup__title">{ru?'Обработка изображений':'Image processing'}</div>
          <ul class="tags">{mediaTags.map(tag=><li class="tag">{tag}</li>)}</ul>
        </div></div>
      </article>
    </aside>
  </div>
</section>
</Layout>
<style>
.cv-home{padding-block:16px 32px}
.cv-grid :global([id^="role-"]){scroll-margin-top:85px}
@media(min-width:960px){
  .cv-sidebar{grid-column:1;grid-row:1}
  .cv-main{grid-column:2;grid-row:1;min-width:0}
}
@media(max-width:959px){
  .cv-grid .cv-extra{order:6}
}
</style>
