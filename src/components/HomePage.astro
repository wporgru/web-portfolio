---
import Layout from './Layout.astro';
import { getEntry } from 'astro:content';
import copy from '../content/portfolio-home.json';
import { caseHighlights } from '../content/case-highlights.mjs';
import { services } from '../content/services.mjs';
import { guides } from '../content/guides.mjs';
const { lang='ru', profile='', downloadUrls } = Astro.props;
const ru = lang === 'ru';
const c = ru ? copy.ru : copy.en;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const catalog = base + '/showcase' + (ru ? '/' : '/en/');
const projects = (await getEntry('showcase', 'projects_' + lang))?.data.projects ?? [];
const picks = ['78-dosok','stalex-feed','arenda-pm-home-performance','diskprices-comparison-platform','wellland-facets','tara-bergman','seo-dashboard','codex-marketing-skills-workflow','wellland-editorial-ai-production','medicine-data'].flatMap(slug => projects.filter(p => p.slug === slug));
const contacts = [
  {label:'Telegram · @wporgru',url:'https://t.me/wporgru'},
  {label:'zakaz@wp.org.ru',url:'mailto:zakaz@wp.org.ru'},
  {label:'+7 (831) 291-36-31',url:'tel:+78312913631'},
  {label:'Kwork',url:'https://kwork.ru/user/wporgru'},
  {label:'GitHub',url:'https://github.com/wporgru'},
  {label:'WP.ORG.RU',url:'https://wp.org.ru/contacts/'},
];
const skillTags = [
  ['JavaScript','React','Astro','HTML','CSS',ru?'HTML-подписи для Outlook':'HTML email signatures for Outlook',ru?'Адаптивная вёрстка':'Responsive design','Gutenberg',ru?'Библиотеки блоков':'Reusable block patterns','GeneratePress','Elementor','WoodMart'],
  ['PHP','Laravel','PHPUnit','Express',ru?'Серверный рендеринг HTML':'Server-side HTML rendering','WordPress','WooCommerce','Directus','REST API','InSales','PHP 8',ru?'Смена темы действующего магазина':'Live store theme replacement',ru?'Аудит и очистка плагинов':'Plugin auditing and cleanup'],
  ['Python','Node.js','SQLite','XML','XLSX',ru?'Парсинг':'Web scraping','WP All Import','1С',ru?'Нормализация данных':'Data normalization'],
  ['Codex','Antigravity','Prompt engineering',ru?'Локальные навыки Codex':'Local Codex skills',ru?'Аудит инструкций для агента':'Agent instruction review',ru?'Границы доступа и действий':'Agent permission and action boundaries',ru?'Разбор кода и данных с ИИ':'AI-assisted code and data analysis',ru?'Редактура AI-контента':'AI content editing',ru?'Проверка результатов ИИ':'AI output validation'],
  ['Yandex Webmaster','Metrica','Google Search Console','IndexNow',ru?'Технический аудит':'Technical audits','Canonical','Sitemap','301 redirects'],
  ['Git','GitHub Actions','Playwright',ru?'Миграция сайтов':'Site migrations',ru?'Тестовый стенд':'Staging',ru?'Диагностика PHP и плагинов':'PHP and plugin diagnostics',ru?'Браузерные регрессии':'Browser regression testing',ru?'План отката':'Rollback planning'],
];
const skillExamples = [
  ['nomad-spain-landing-figma', 'Адаптивная вёрстка по Figma', 'Responsive Figma implementation'],
  ['diskprices-comparison-platform', 'Laravel: сравнение цен и история предложений', 'Laravel: price comparison and offer history'],
  ['medicine-data', 'Python и Directus: нормализация справочников', 'Python and Directus: reference data normalization'],
  ['codex-marketing-skills-workflow', 'Codex: аудит и настройка агентных навыков', 'Codex: auditing and configuring agent skills'],
  ['education-store-crawl-audit', 'Технический SEO-аудит каталога на 3 508 URL', 'Technical SEO audit of a 3,508-URL catalog'],
  ['artred-woocommerce-migration-readiness', 'Подготовка переноса магазина с проверками и планом отката', 'Store cutover preparation with checks and rollback'],
] as const;
const projectHref = (slug: string) => `${base}/showcase/${slug}${ru?'/':'/en/'}`;
const commerceTags = ['YooKassa','CDEK','SafeRoute','Shiptor',ru?'YML для Яндекс Маркета':'Yandex Market YML feeds',ru?'Платёжные сценарии':'Payment flows',ru?'Фильтры каталога':'Catalog filters',ru?'Поиск по артикулу':'SKU search',ru?'Приоритеты фидов поставщиков':'Supplier feed precedence',ru?'Глобальные атрибуты':'Global product attributes',ru?'Вариативные товары':'Product variations',ru?'Проверка остатков из 1С':'1C stock validation',ru?'Товарные фиды':'Product feeds',ru?'Партнёрские витрины':'Affiliate storefronts'];
const seoTags = ['Rank Math','Yoast SEO','Screaming Frog','GA4','Google Trends',ru?'Аудит метаданных':'Metadata audits',ru?'Региональные поддомены':'Regional subdomains','WordPress Multisite',ru?'Сверка URL при миграции':'URL verification during migrations',ru?'Цели покупки в Яндекс Метрике':'Yandex Metrica purchase goals',ru?'Атрибуция партнёрских переходов':'Affiliate click attribution',ru?'Сопоставление заказов по SubID':'SubID order reconciliation'];
const performanceTags = ['PageSpeed Insights','LCP','Critical CSS',ru?'Оптимизация первого экрана':'Above-the-fold optimization',ru?'Проверка кэша без авторизации':'Logged-out cache testing'];
const localizationTags = [ru?'Испанская локализация':'Spanish localization',ru?'Португалоязычные сайты':'Portuguese-language websites',ru?'Мультиязычные меню':'Multilingual navigation',ru?'Выбор города':'City selection',ru?'Сохранение региона в cookie':'Cookie-based region preferences'];
const orderTags = [ru?'Транзакционные письма':'Transactional email',ru?'Статусы заказов':'Order statuses',ru?'Подарки по сумме корзины':'Cart-based gift rules',ru?'Тестирование форм бронирования':'Booking form testing',ru?'Корзина-заявка для B2B':'B2B enquiry carts',ru?'PDF-счета и согласование заказа':'PDF invoicing and order approval'];
const mediaTags = ['WebP','XnView',ru?'Оптимизация медиатеки WordPress':'WordPress media optimization',ru?'Исправление миниатюр каталога':'Catalog thumbnail repair',ru?'ИИ-увеличение изображений':'AI image upscaling',ru?'Генерация редакционных обложек по референсам':'Reference-based editorial cover generation'];
const recoveryTags = ['ACF','MySQL','RabbitLoader','WP Rocket',ru?'Откат базы из резервной копии':'Database rollback from backup',ru?'Диагностика сбоев после обновления':'Post-update troubleshooting',ru?'Восстановление доступа в wp-admin':'WordPress admin access recovery'];
const opsTags = ['Linux','Bash','cron','pigz',ru?'Обслуживание VPS':'VPS maintenance',ru?'Автоматизация резервных копий':'Backup automation',ru?'Проверка архивов и ротация':'Archive validation and retention',ru?'Аудит зависимостей медиатеки':'Media dependency auditing'];
const roleLinks = c.roles.map(([label],i)=>({label,href:'#role-'+(i+1)}));
const roleServices = ['website-redesign','catalog-automation','data-and-ai','technical-seo'].map(slug=>services.find(service=>service.slug===slug)!);
const roleServiceSlugs = new Set(roleServices.map(service=>service.slug));
const extraServices = services.filter(service=>!roleServiceSlugs.has(service.slug));
const person = {name:ru?'Олег Тишин':'Oleg Tishin',jobTitle:c.h1,email:'zakaz@wp.org.ru',sameAs:contacts.filter(x=>x.url.startsWith('https')).map(x=>x.url)};
const workSteps = ru ? [
  ['Сначала выясняю, где ломается сценарий', 'Проверяю сайт глазами посетителя: находит ли он товар, открывается ли форма, читается ли страница на телефоне. Отделяю ошибки, которые мешают заявке, от правок оформления.', 'solomon-responsive-conversion-audit', 'Как проверял кнопки и мобильную вёрстку'],
  ['Согласую, что меняем и что сохраняем', 'Для редизайна это могут быть адреса, данные каталога и оформление заказа. Для импорта — ключи товаров, поля, которые нельзя перезаписывать, и правила для отсутствующих позиций. Если есть риск потерять данные, выделяю тестовую копию и план отката.', 'artred-woocommerce-migration-readiness', 'Как готовил перенос каталога и статей'],
  ['Проверяю результат на реальных сценариях', 'После изменений повторяю согласованные проверки и передаю результаты. Если замер был лабораторным, так и отмечаю. Открытие формы не считается доставкой заявки, а отправка URL — индексацией.', 'arenda-pm-home-performance', 'Как проверял скорость и работу мобильной главной'],
] : [
  ['Find where the customer journey breaks', 'Review the site as a visitor: can they find a product, open a form and read the page on a phone? Separate issues that block enquiries from visual adjustments.', 'solomon-responsive-conversion-audit', 'How I tested buttons and mobile layouts'],
  ['Agree on what changes and what stays', 'For a redesign, that could mean URLs, catalog data and checkout. For an import, agree on product keys, fields to preserve and how to handle missing records. If data could be lost, plan staging and rollback first.', 'artred-woocommerce-migration-readiness', 'How I prepared the catalog and article migration'],
  ['Retest the real workflows', 'Repeat the agreed checks after implementation and share the results. Label lab measurements as such. An open form does not prove delivery, and submitting a URL does not prove indexing.', 'arenda-pm-home-performance', 'How I tested speed and mobile homepage behavior'],
];
const projectBrief = [
  ru?'Ссылка на сайт или пример:':'Website or reference URL:',
  ru?'Задача и ожидаемый результат:':'Task and expected result:',
  ru?'Что важно сохранить:':'What must stay intact:',
  ru?'Желаемые сроки:':'Preferred timeline:',
].join('\r\n\r\n');
const briefEmail = 'mailto:'+person.email+'?subject='+encodeURIComponent(ru?'Задача по веб-разработке':'Web development enquiry')+'&body='+encodeURIComponent(projectBrief);
---
<Layout title={c.title} description={c.description} lang={lang} profile={profile} section="main" personJsonLd={person} roleLinks={roleLinks}>
<section class="container cv-home">
  <div class="page-grid cv-grid">
    <div class="main-content cv-main">
      <article class="card hero">
        <div class="hero__top">
          <div>
            <h1 class="hero__name">{person.name} — {ru ? 'веб-разработчик' : 'web developer'}</h1>
            <p class="hero__title">{ru ? 'Full-stack · E-commerce · Автоматизация и ИИ' : 'Full-stack · E-commerce · Automation and AI'}</p>
            <p class="hero__summary">{c.description} {ru ? 'Более 15 лет в веб-разработке.' : 'Over 15 years in web development.'}</p>
            <div class="btnrow">
              <a class="btn" href="https://t.me/wporgru">{ru?'Обсудить проект':'Discuss a project'}</a>
              <a class="btn btn--ghost" href={base+'/services'+(ru?'/':'/en/')}>{ru?'Выбрать услугу':'Explore services'}</a>
              <a class="btn btn--ghost" href="#project-brief">{ru?'Что прислать для оценки':'What to send for an estimate'}</a>
            </div>
          </div>
        </div>
        <div class="hero__contacts">
          <div class="section__title">{ru ? 'Контакты' : 'Contacts'}</div>
          <div class="pillrow">{contacts.map(x=><a class="pill" href={x.url}>{x.label}</a>)}</div>
        </div>
      </article>

      <article class="card card--achievements">
        <h2 class="h2">{ru ? 'Достижения и результаты проектов' : 'Project achievements and measurable results'}</h2>
        <ul class="list">
          <li><a href={catalog}><strong>{projects.length} {ru?'кейсов в портфолио':'portfolio case studies'}</strong></a> — {ru?'с задачами, решениями и результатами на русском и английском.':'with briefs, solutions and outcomes in Russian and English.'}</li>
          <li>{ru ? '582 выполненных заказа в собранном архиве Kwork; 371 отзыв сохранён со скриншотом.' : '582 completed orders in the collected Kwork archive; 371 reviews archived with screenshots.'}</li>
          {c.results.map(([title,body])=><li><strong>{title}.</strong> {body}</li>)}
          <li><a href={base+'/showcase/arenda-pm-home-performance/'+(ru?'':'en/')}><strong>PageSpeed 72 → 96</strong></a> — {ru?'мобильная главная Аренда-ПМ: LCP 6,8 → 2,7 с в лабораторных замерах.':'Arenda-PM mobile homepage: LCP 6.8 → 2.7 s in lab measurements.'}</li>
          <li><a href={base+'/showcase/arenda-pm-catalog-indexability/'+(ru?'':'en/')}><strong>{ru?'Аренда-ПМ: 14 карточек открыты для индексации':'Arenda-PM: 14 listings made indexable'}</strong></a> — {ru?'сверил 83 адреса карты сайта и убрал подмены метаданных в теме.':'verified 83 sitemap URLs and removed theme metadata overrides.'}</li>
          <li><a href={base+'/showcase/bgtgroup-technical-seo-performance/'+(ru?'':'en/')}><strong>BGT Group: PageSpeed 37 → 86</strong></a> — {ru?'мобильный лабораторный замер; на компьютере 63 → 92.':'mobile lab measurement; desktop 63 → 92.'}</li>
          <li><a href={base+'/showcase/klimat-profi-server-storage/'+(ru?'':'en/')}><strong>{ru?'Климат Профи: 8,3 → 83 ГБ свободного места':'Klimat Profi: 8.3 → 83 GB free server space'}</strong></a> — {ru?'по отчёту первого этапа расчистки VPS магазина.':'as recorded in the first-stage store VPS cleanup report.'}</li>
          <li><a href={base+'/showcase/faeton-blog-tag-archive-recovery/'+(ru?'':'en/')}><strong>{ru?'«Фаэтон»: 81 восстановленный архив тегов':'Faeton: 81 restored tag archives'}</strong></a> — {ru?'исправил ошибочный редирект и устранил пропуски записей при перелистывании.':'fixed the erroneous redirect and removed pagination gaps.'}</li>
          <li><a href={base+'/showcase/wellland-editorial-ai-production/'+(ru?'':'en/')}><strong>{ru?'Wellland: 6 публикаций и обложки на 93,8% легче':'Wellland: 6 publications and 93.8% lighter covers'}</strong></a> — {ru?'запустил редакционный раздел с кейсами, фильтрами по отраслям и подписанными ИИ-иллюстрациями.':'launched an editorial section with case studies, industry filters and labeled AI illustrations.'}</li>
          <li><a href={base+'/showcase/megawatt-service-template-migration/'+(ru?'':'en/')}><strong>{ru?'«Мегаватт»: 136 страниц услуг на новом шаблоне':'Megawatt: 136 service pages on a new template'}</strong></a> — {ru?'на тестовой копии проверил все страницы; у 135 из 136 сохранились адреса.':'verified every page on staging; 135 of 136 kept their URLs.'}</li>
        </ul>
      </article>

      <section class="section section--experience">
        <h2 class="h2">{ru ? 'Профессиональный опыт в веб-разработке' : 'Professional web development experience'}</h2>
        <div class="stack">
          {c.experience.map(([title,body])=>{
            const [name,period]=title.split(' · ');
            return <article class="card item">
              <div class="item__top"><strong>{name}</strong><span class="muted">{period}</span></div>
              <ul class="list"><li>{body}</li></ul>
            </article>;
          })}
        </div>
      </section>

      <section class="section cv-extra">
        <h2 class="h2">{c.rolesTitle}</h2>
        <div class="stack">{c.roles.map(([title,body],i)=><article class="card item" id={'role-'+(i+1)}>
          <h3 class="h2">{title}</h3>
          <p class="muted">{body}</p>
          <a class="pill" href={base+'/services/'+roleServices[i].slug+(ru?'/':'/en/')}>{roleServices[i][ru?'ru':'en'][0]}</a>
        </article>)}</div>
        {extraServices.map(service=><article class="card item" style="margin-top: 14px">
          <h3 class="h2">{service[ru?'ru':'en'][0]}</h3>
          <p class="muted">{service[ru?'ru':'en'][1]}</p>
          <a class="pill" href={base+'/services/'+service.slug+(ru?'/':'/en/')}>{ru?'Что входит в работу':'What the work covers'}</a>
        </article>)}
      </section>

      <section class="section cv-extra">
        <h2 class="h2">{c.workTitle}</h2>
        <div class="stack">{picks.map(p=><article class="card item"><h3 class="h2"><a href={base+'/showcase/'+p.slug+(ru?'/':'/en/')}>{p.name}</a></h3><p class="muted">{caseHighlights[p.slug]?.[ru?'ru':'en'] ?? p.description}</p></article>)}</div>
        <p><a class="btn btn--ghost" href={catalog}>{c.all} →</a></p>
      </section>

      <section class="section cv-extra">
        <h2 class="h2">{ru?'Как я веду проекты и проверяю результат':'How I plan projects and verify outcomes'}</h2>
        <ol class="list work-steps">
          {workSteps.map(([title,body,slug,label])=><li class="card item">
            <h3 class="h2">{title}</h3>
            <p>{body}</p>
            <a href={base+'/showcase/'+slug+(ru?'/':'/en/')}>{label}</a>
          </li>)}
        </ol>
      </section>

      <section class="card cv-extra">
        <h2 class="h2">{ru?'Практические руководства для владельцев сайтов':'Practical guides for site owners'}</h2>
        <ul class="list">
          {guides.map(guide=><li><a href={base+'/guides/'+guide.slug+(ru?'/':'/en/')}>{guide[ru?'ru':'en'].title}</a></li>)}
        </ul>
      </section>

      <section class="card cv-extra" id="project-brief" aria-labelledby="project-brief-title">
        <h2 class="h2" id="project-brief-title">{c.contactTitle}</h2>
        <p>{c.contactText}</p>
        <ul class="list">
          <li>{ru?'Новый сайт: пример, основные разделы и действие, которое должен выполнить посетитель.':'New site: a reference, key sections and the action visitors should take.'}</li>
          <li>{ru?'Доработка: адрес страницы, что происходит сейчас и что должно измениться.':'Existing site: the affected URL, current behavior and desired change.'}</li>
          <li>{ru?'Импорт или автоматизация: небольшой пример исходных данных и ожидаемого результата.':'Import or automation: a small sample of the input and expected output.'}</li>
        </ul>
        <p class="muted">{ru?'Доступы и пароли для первого обсуждения не нужны.':'No credentials or passwords are needed for the first discussion.'}</p>
        <div class="btnrow">
          <a class="btn" href={briefEmail}>{ru?'Открыть шаблон письма':'Open enquiry email template'}</a>
          <a class="btn btn--ghost" href="https://t.me/wporgru">{ru?'Написать в Telegram':'Message me on Telegram'}</a>
        </div>
      </section>
    </div>

    <aside class="sidebar cv-sidebar">
      <article class="card card--downloads" id="resume" tabindex="-1" aria-labelledby="resume-heading">
        <h2 class="h2" id="resume-heading">{ru ? 'Скачать резюме и портфолио' : 'Download résumé and portfolio'}</h2>
        <div class="skillsgroup__title">{ru ? 'Людям' : 'For people'}</div>
        <div class="btnrow">
          <a class="btn" href={downloadUrls.pdf} download aria-label={ru ? 'Скачать резюме PDF' : 'Download resume PDF'}>PDF</a>
          <a class="btn btn--ghost" href={downloadUrls.docx} download aria-label={ru ? 'Скачать резюме DOCX' : 'Download resume DOCX'}>DOCX</a>
        </div>
        <div class="skillsgroup__title">{ru ? 'Для ATS' : 'For ATS'}</div>
        <div class="btnrow">
          <a class="btn btn--ghost" href={downloadUrls.pdfAts} download aria-label={ru ? 'Скачать одноколоночное резюме PDF для ATS' : 'Download single-column ATS resume PDF'}>PDF</a>
          <a class="btn btn--ghost" href={downloadUrls.txt} download aria-label={ru ? 'Скачать текстовое резюме TXT' : 'Download plain text resume'}>TXT</a>
        </div>
      </article>
      <article class="card card--skills">
        <h2 class="h2">{ru ? 'Навыки и технологии веб-разработки' : 'Web development skills and technologies'}</h2>
        <div class="skillsgrid">{c.skills.map(([group],i)=><div class="skillsgroup">
          <div class="skillsgroup__title">{group}</div>
          <ul class="tags">{skillTags[i].map(tag=><li class="tag">{tag}</li>)}</ul>
          <p class="skill-example">{ru?'Кейс:':'Case study:'} <a data-skill-example href={projectHref(skillExamples[i][0])}>{skillExamples[i][ru?1:2]}</a></p>
          {i===0 && <p class="skill-example">{ru?'Виджет без CMS:':'CMS-independent widget:'} <a href={projectHref('messenger-widget-code-handoff')}>{ru?'HTML/CSS/JS и проверка на двух экранах':'HTML, CSS and JS tested at two viewport sizes'}</a></p>}
          {i===0 && <p class="skill-example">{ru?'Почтовая вёрстка:':'Email development:'} <a href={projectHref('corporate-email-signatures-47')}>{ru?'47 персональных HTML-подписей':'47 personalized HTML signatures'}</a></p>}
          {i===3 && <p class="skill-example">{ru?'ИИ в редакционном процессе:':'AI in editorial production:'} <a href={projectHref('wellland-editorial-ai-production')}>{ru?'Шесть обложек по референсам, маркировка и оптимизация WebP':'Six reference-based covers, AI labeling and WebP optimization'}</a></p>}
        </div>)}<div class="skillsgroup">
          <div class="skillsgroup__title">{ru?'Интернет-магазины и интеграции':'Commerce and integrations'}</div>
          <ul class="tags">{commerceTags.map(tag=><li class="tag">{tag}</li>)}</ul>
          <p class="skill-example">{ru?'Доставка:':'Shipping:'} <a href={projectHref('saferoute-shipping-migration')}>{ru?'Переход с Shiptor на SafeRoute':'Migrating from Shiptor to SafeRoute'}</a></p>
          <p class="skill-example">{ru?'Маркетплейсы:':'Marketplaces:'} <a href={projectHref('blaskos-yandex-market-category-feed')}>{ru?'YML-выгрузка выбранных категорий':'YML export for selected categories'}</a></p>
        </div><div class="skillsgroup">
          <div class="skillsgroup__title">{ru?'Поисковый аудит и оптимизация':'Search auditing and optimization'}</div>
          <ul class="tags">{seoTags.map(tag=><li class="tag">{tag}</li>)}</ul>
        </div><div class="skillsgroup">
          <div class="skillsgroup__title">{ru?'Скорость загрузки':'Web performance'}</div>
          <ul class="tags">{performanceTags.map(tag=><li class="tag">{tag}</li>)}</ul>
        </div><div class="skillsgroup">
          <div class="skillsgroup__title">{ru?'Локализация и региональные сайты':'Localization and regional websites'}</div>
          <ul class="tags">{localizationTags.map(tag=><li class="tag">{tag}</li>)}</ul>
        </div><div class="skillsgroup">
          <div class="skillsgroup__title">{ru?'Заказы, уведомления и акции':'Orders, notifications and promotions'}</div>
          <ul class="tags">{orderTags.map(tag=><li class="tag">{tag}</li>)}</ul>
        </div><div class="skillsgroup">
          <div class="skillsgroup__title">{ru?'Обработка изображений':'Image processing'}</div>
          <ul class="tags">{mediaTags.map(tag=><li class="tag">{tag}</li>)}</ul>
        </div><div class="skillsgroup">
