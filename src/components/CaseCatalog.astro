---
const {projects,lang,t,eagerIdx}=Astro.props;
import ProjectCard from './ProjectCard.astro';
import { services } from '../content/services.mjs';
import { serviceGroups } from '../content/service-groups.mjs';
const ru=lang==='ru';
const locale=ru?'ru':'en';
const base=import.meta.env.BASE_URL.replace(/\/$/, '');
const starters=[
  ['Импорт и товарные фиды','Catalog imports and feeds','construction-catalog-variants'],
  ['Редизайн магазина','Store redesign','78-dosok'],
  ['B2B-каталог и заявки','B2B catalog and enquiries','artred-b2b-equipment-catalog'],
  ['Подбор оборудования','Equipment selector','potoc-heater-selection-prototype'],
  ['Чекаут и оплата','Checkout and payments','yookassa-test-order'],
  ['Техническое SEO','Technical SEO','regional-seo-metadata'],
  ['Переезд и скорость','Migration and performance','schmidt-studio-migration-performance'],
  ['Автоматизация и данные','Automation and data','medicine-data'],
].filter(([, , slug])=>projects.some((p:any)=>p.slug===slug));
const tags=[...new Set<string>(projects.flatMap((p:any)=>p.stack ?? []))].sort((a,b)=>a.localeCompare(b,lang));
const servicesBySlug=new Map(services.map(service=>[service.slug,service]));
const availableSlugs=new Set(projects.map((project:any)=>project.slug));
const taskOptions=serviceGroups.map(group=>({
  label:group[locale][0],
  services:group.slugs.map(slug=>servicesBySlug.get(slug)!).map(service=>({
    slug:service.slug, label:service[locale][0],
    count:service.cases.filter(slug=>availableSlugs.has(slug)).length,
  })).filter(service=>service.count),
}));
const projectTasks=new Map<string,string[]>();
for(const service of services)for(const slug of service.cases){
  const tasks=projectTasks.get(slug)??[];
  tasks.push(service.slug);
  projectTasks.set(slug,tasks);
}
const dateKey=(value:unknown)=>{
  const match=String(value??'').match(/^(?:(?:\d{2}[–-])?(\d{2})\.)?(\d{4})$/);
  return match ? Number(match[2])*100+Number(match[1]??0) : 0;
};
---
<nav class="card case-paths" aria-label={ru?'Примеры по задачам':'Examples by need'}>
  <p>{ru?'Посмотрите, как я решал похожие задачи':'See how I approached similar projects'}</p>
  <ul class="tags">{starters.map(([labelRu,labelEn,slug])=><li><a class="pill" href={base+'/showcase/'+slug+(ru?'/':'/en/')}>{ru?labelRu:labelEn}</a></li>)}</ul>
</nav>
<case-catalog>
  <form class="card case-search" role="search">
    <fieldset disabled>
    <label>{ru?'Поиск по кейсам':'Search case studies'}<input type="search" name="q" placeholder={ru?'Например, импорт или Dokan':'For example, import or Dokan'} /></label>
    <label>{ru?'Задача клиента':'Client need'}<select name="task"><option value="">{ru?'Все задачи':'All client needs'}</option>{taskOptions.map(group=><optgroup label={group.label}>
      {group.services.map(service=><option value={service.slug}>{service.label} ({service.count})</option>)}
    </optgroup>)}</select></label>
    <label>{ru?'Технология':'Technology'}<select name="tech"><option value="">{ru?'Все технологии':'All technologies'}</option>{tags.map(tag=><option value={tag}>{tag}</option>)}</select></label>
    <label>{ru?'Порядок':'Sort by'}<select name="order"><option value="featured">{ru?'Подборка':'Portfolio order'}</option><option value="recent">{ru?'Сначала новые':'Newest first'}</option><option value="oldest">{ru?'Сначала ранние':'Oldest first'}</option></select></label>
    <button class="btn btn--ghost" type="reset">{ru?'Сбросить':'Reset'}</button>
    <output aria-live="polite">{ru?`Показано: ${projects.length} из ${projects.length}`:`Showing ${projects.length} of ${projects.length}`}</output>
    </fieldset>
  </form>
  <noscript><p class="muted">{ru?'Фильтры требуют JavaScript. Все кейсы доступны ниже.':'Filters require JavaScript. Every case is listed below.'}</p></noscript>
  <p class="card" data-case-empty hidden>{ru?'Ничего не найдено. Попробуйте другое слово или сбросьте фильтры.':'No cases found. Try a different keyword or reset the filters.'}</p>
  <div class="grid" data-case-grid>
    {projects.map((p:any,i:number)=><div data-case={p.slug} data-date={dateKey(p.year)} data-tasks={projectTasks.get(p.slug)?.join(' ')}>
      <ProjectCard project={p} eager={i===eagerIdx} t={t} lang={locale}/>
    </div>)}
  </div>
</case-catalog>
<script>
class CaseCatalog extends HTMLElement {
  connectedCallback() {
    const form=this.querySelector('form');
    const fields=form?.querySelector('fieldset');
    const query=form?.querySelector('input');
    const tech=form?.querySelector<HTMLSelectElement>('select[name="tech"]');
    const task=form?.querySelector<HTMLSelectElement>('select[name="task"]');
    const order=form?.querySelector<HTMLSelectElement>('select[name="order"]');
    const output=form?.querySelector('output');
    const grid=this.querySelector('[data-case-grid]');
    const empty=this.querySelector<HTMLElement>('[data-case-empty]');
    if(!form||!fields||!query||!tech||!task||!order||!output||!grid||!empty)return;
    const lang=document.documentElement.lang;
    const normalize=(value:string)=>value.toLocaleLowerCase(lang).replace(/ё/g,'е');
    // Search the existing HTML; do not ship a second copy of descriptions or stack tags.
    const cards=[...grid.querySelectorAll<HTMLElement>('[data-case]')].map(el=>({
      el,tasks:(el.dataset.tasks??'').split(' '),date:Number(el.dataset.date),
      tags:undefined as string[]|undefined,text:undefined as string|undefined,
    }));
    const tagsFor=(card:typeof cards[number])=>card.tags??=Array.from(
      card.el.querySelectorAll('[data-project-stack] > li'),item=>item.textContent??'',
    );
    const textFor=(card:typeof cards[number])=>card.text??=normalize([
      card.el.querySelector('.card__title')?.textContent,
      card.el.querySelector('.card__desc')?.textContent,
      card.el.querySelector('[data-project-year]')?.textContent?.replace(/^\s*·\s*/,''),
      ...tagsFor(card),
    ].join(' '));
    const restoreTask=()=>{
      const value=new URL(location.href).searchParams.get('task')??'';
      task.value=[...task.options].some(option=>option.value===value)?value:'';
    };
    const syncTask=()=>{
      const url=new URL(location.href);
      if(task.value)url.searchParams.set('task',task.value);
      else url.searchParams.delete('task');
      if(url.href!==location.href)history.replaceState(history.state,'',url);
    };
    let currentOrder='featured';
    const update=()=>{
      if(order.value!==currentOrder){
        currentOrder=order.value;
        const sorted=currentOrder==='featured'?cards:[...cards].sort((a,b)=>{
          if(!a.date||!b.date)return Number(!a.date)-Number(!b.date);
          return currentOrder==='recent'?b.date-a.date:a.date-b.date;
        });
        grid.append(...sorted.map(card=>card.el));
      }
      const words=normalize(query.value.trim()).split(/\s+/).filter(Boolean);
      let visible=0;
      for(const card of cards){
        const matches=(!task.value||card.tasks.includes(task.value)) &&
          (!tech.value||tagsFor(card).includes(tech.value)) &&
          (!words.length||words.every(word=>textFor(card).includes(word)));
        if(card.el.hidden===matches) card.el.hidden=!matches;
        if(matches)visible++;
      }
      empty.hidden=visible>0;
      output.value=lang==='ru'?`Показано: ${visible} из ${cards.length}`:`Showing ${visible} of ${cards.length}`;
    };
    form.addEventListener('input',update);
    task.addEventListener('change',syncTask);
    form.addEventListener('submit',event=>{event.preventDefault();update();});
    form.addEventListener('reset',event=>{
      event.preventDefault();
      query.value=query.defaultValue;
      tech.value='';
      task.value='';
      order.value='featured';
      syncTask();
      update();
    });
    restoreTask();
    update();
    fields.disabled=false;
  }
}
if(!customElements.get('case-catalog'))customElements.define('case-catalog',CaseCatalog);
</script>
<style>
.case-paths{margin-bottom:1rem}
.case-paths p{margin:0 0 .65rem;font-weight:650}
.case-search{margin-bottom:1rem}
.case-search fieldset{display:flex;align-items:end;flex-wrap:wrap;gap:1rem;border:0;margin:0;padding:0;min-inline-size:0}
.case-search label{display:grid;gap:.35rem;flex:1 1 210px;min-width:0}
.case-search input,.case-search select{font:inherit;width:100%;min-width:0;padding:.55rem;color:var(--text);background:var(--card-bg);border:1px solid var(--border);border-radius:8px}
.case-search option{background:#182438;color:white}
.case-search output{padding:.55rem 0;color:var(--muted);min-inline-size:13.5ch}
[data-case][hidden],[data-case-empty][hidden]{display:none}
@media (scripting: none){.case-search{display:none}}
</style>
