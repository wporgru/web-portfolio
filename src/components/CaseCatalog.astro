---
const {projects,lang,t,eagerIdx}=Astro.props;
import ProjectCard from './ProjectCard.astro';
const ru=lang==='ru';
const base=import.meta.env.BASE_URL.replace(/\/$/, '');
const starters=[
  ['Импорт и товарные фиды','Catalog imports and feeds','construction-catalog-variants'],
  ['Редизайн магазина','Store redesign','78-dosok'],
  ['Чекаут и оплата','Checkout and payments','yookassa-test-order'],
  ['Техническое SEO','Technical SEO','regional-seo-metadata'],
  ['Переезд и скорость','Migration and performance','schmidt-studio-migration-performance'],
  ['Автоматизация и данные','Automation and data','medicine-data'],
].filter(([, , slug])=>projects.some((p:any)=>p.slug===slug));
const tags=[...new Set<string>(projects.flatMap((p:any)=>p.stack ?? []))].sort((a,b)=>a.localeCompare(b,lang));
const dateKey=(value:unknown)=>{
  const match=String(value??'').match(/^(?:(?:\d{2}[–-])?(\d{2})\.)?(\d{4})$/);
  return match ? Number(match[2])*100+Number(match[1]??0) : 0;
};
---
<nav class="card case-paths" aria-label={ru?'Примеры по задачам':'Examples by need'}>
  <p>{ru?'Посмотрите, как я решал похожие задачи':'See how I approached similar projects'}</p>
  <ul class="tags">{starters.map(([labelRu,labelEn,slug])=><li><a class="pill" href={base+'/showcase/'+slug+(ru?'/':'/en/')}>{ru?labelRu:labelEn}</a></li>)}</ul>
</nav>
<case-catalog>
  <form class="card case-search" role="search" hidden>
    <label>{ru?'Поиск по кейсам':'Search case studies'}<input type="search" name="q" placeholder={ru?'Например, импорт или Dokan':'For example, import or Dokan'} /></label>
    <label>{ru?'Технология':'Technology'}<select name="tech"><option value="">{ru?'Все технологии':'All technologies'}</option>{tags.map(tag=><option value={tag}>{tag}</option>)}</select></label>
    <label>{ru?'Порядок':'Sort by'}<select name="order"><option value="featured">{ru?'Подборка':'Portfolio order'}</option><option value="recent">{ru?'Сначала новые':'Newest first'}</option><option value="oldest">{ru?'Сначала ранние':'Oldest first'}</option></select></label>
    <button class="btn btn--ghost" type="reset">{ru?'Сбросить':'Reset'}</button>
    <output aria-live="polite"></output>
  </form>
  <p class="card" data-case-empty hidden>{ru?'Ничего не найдено. Попробуйте другое слово или сбросьте фильтры.':'No cases found. Try a different keyword or reset the filters.'}</p>
  <div class="grid" data-case-grid>
    {projects.map((p:any,i:number)=><div data-case data-date={dateKey(p.year)} data-search={[p.name,p.description,p.year,...(p.stack??[])].join(' ').toLocaleLowerCase(lang)} data-tech={JSON.stringify(p.stack??[])}>
      <ProjectCard project={p} eager={i===eagerIdx} t={t}/>
    </div>)}
  </div>
</case-catalog>
<script>
class CaseCatalog extends HTMLElement {
  connectedCallback() {
    const form=this.querySelector('form');
    const query=form?.querySelector('input');
    const tech=form?.querySelector<HTMLSelectElement>('select[name="tech"]');
    const order=form?.querySelector<HTMLSelectElement>('select[name="order"]');
    const output=form?.querySelector('output');
    const grid=this.querySelector('[data-case-grid]');
    const empty=this.querySelector<HTMLElement>('[data-case-empty]');
    if(!form||!query||!tech||!order||!output||!grid||!empty)return;
    const lang=document.documentElement.lang;
    const normalize=(value:string)=>value.toLocaleLowerCase(lang).replace(/ё/g,'е');
    const cards=[...grid.querySelectorAll<HTMLElement>('[data-case]')].map(el=>({el,tags:JSON.parse(el.dataset.tech??'[]') as string[],text:normalize(el.dataset.search??''),date:Number(el.dataset.date)}));
    let currentOrder='featured';
    const update=()=>{
      if(order.value!==currentOrder){
        currentOrder=order.value;
        const sorted=currentOrder==='featured'?cards:[...cards].sort((a,b)=>{
          if(!a.date||!b.date)return Number(!a.date)-Number(!b.date);
          return currentOrder==='recent'?b.date-a.date:a.date-b.date;
        });
        grid.append(...sorted.map(card=>card.el));
      }
      const words=normalize(query.value.trim()).split(/\s+/).filter(Boolean);
      let visible=0;
      for(const {el,tags,text} of cards){
        const matches=words.every(word=>text.includes(word)) && (!tech.value||tags.includes(tech.value));
        el.hidden=!matches;
        if(matches)visible++;
      }
      empty.hidden=visible>0;
      output.value=lang==='ru'?`Показано: ${visible} из ${cards.length}`:`Showing ${visible} of ${cards.length}`;
    };
    form.addEventListener('input',update);
    form.addEventListener('submit',event=>{event.preventDefault();update();});
    form.addEventListener('reset',event=>{
      event.preventDefault();
      query.value=query.defaultValue;
      tech.value='';
      order.value='featured';
      update();
    });
    form.hidden=false; update();
  }
}
if(!customElements.get('case-catalog'))customElements.define('case-catalog',CaseCatalog);
</script>
<style>
.case-paths{margin-bottom:1rem}
.case-paths p{margin:0 0 .65rem;font-weight:650}
.case-search:not([hidden]){display:flex;align-items:end;flex-wrap:wrap;gap:1rem;margin-bottom:1rem}
.case-search label{display:grid;gap:.35rem;flex:1 1 210px}
.case-search input,.case-search select{font:inherit;width:100%;padding:.55rem;color:var(--text);background:var(--card-bg);border:1px solid var(--border);border-radius:8px}
.case-search option{background:#182438;color:white}
.case-search output{padding:.55rem 0;color:var(--muted)}
[data-case][hidden],[data-case-empty][hidden]{display:none}
</style>
