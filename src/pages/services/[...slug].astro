---
import Layout from '../../components/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getEntry } from 'astro:content';
import { services } from '../../content/services.mjs';
import { serviceDetails } from '../../content/service-details.mjs';
import { createEnquiry } from '../../content/enquiry.mjs';
import { servicePaths } from '../../content/service-paths.mjs';
import { guides } from '../../content/guides.mjs';
import { caseHighlights } from '../../content/case-highlights.mjs';

export function getStaticPaths() {
  return services.flatMap(service => ['ru','en'].map(lang => ({
    params: { slug: service.slug + (lang === 'en' ? '/en' : '') },
    props: { service, lang },
  })));
}

const { service, lang } = Astro.props;
const ru = lang === 'ru';
const providerName = ru?'Олег Тишин':'Oleg Tishin';
const [title, intro, first, second, outcome] = service[ru ? 'ru' : 'en'];
const [scenario, approach, deliverables] = serviceDetails[service.slug][ru ? 'ru' : 'en'];
const questions = serviceDetails[service.slug].questions?.[ru ? 'ru' : 'en'] ?? [];
const steps = serviceDetails[service.slug].steps?.[ru ? 'ru' : 'en'] ?? [];
const enquiry = createEnquiry({
  lang, title, kind:'service', serviceSlug:service.slug,
  url:new URL(Astro.url.pathname,Astro.site ?? Astro.url).href,
});
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const localeSuffix = ru ? '/' : '/en/';
const breadcrumbs = [
  {name:ru?'Главная':'Home',href:base+localeSuffix},
  {name:ru?'Услуги':'Services',href:base+'/services'+localeSuffix},
  {name:title},
];
const alternate = ['ru','en'].map(id => ({ id, label:id.toUpperCase(), href:base+'/services/'+service.slug+(id==='ru'?'/':'/en/'), active:id===lang }));
const projects = (await getEntry('showcase', 'projects_'+lang))?.data.projects ?? [];
const examples = service.cases.map(slug => {
  const p = projects.find(p => p.slug === slug);
  if (!p) throw Error('Missing service case: '+slug+' ('+lang+')');
  return p;
});
const nextServices=servicePaths[service.slug].map(([slug,ruReason,enReason])=>{
  const target=services.find(item=>item.slug===slug)!;
  return {slug,title:target[ru?'ru':'en'][0],reason:ru?ruReason:enReason};
});
---
<Layout title={title+' — '+providerName} description={intro} lang={lang} section="services" customLangLinks={alternate} roleLinks={[]} breadcrumbs={breadcrumbs} serviceJsonLd={{name:title,providerName}}>
  <div class="container service">
    <Breadcrumbs items={breadcrumbs} lang={lang} />
    <article class="card hero">
      <h1 class="hero__name">{title}</h1>
      <p class="hero__summary">{intro}</p>
      <p class="muted">{ru?'Исполнитель:':'Provided by:'} <a href={base+localeSuffix}>{providerName}</a></p>
      <div class="btnrow">
        <a class="btn" href={enquiry.telegramHref} data-enquiry-telegram>{ru?'Обсудить задачу в Telegram':'Discuss on Telegram'}</a>
        <a class="btn btn--ghost" href={enquiry.href} data-enquiry-email>{ru?'Открыть шаблон письма':'Open enquiry email template'}</a>
      </div>
    </article>
    <section class="card" data-service-scenario>
      <h2 class="h2">{scenario}</h2>
      <p>{approach}</p>
    </section>
    <section class="card">
      <h2 class="h2">{ru?'Что входит в работу':'What the work covers'}</h2>
      <ul class="list"><li>{first}</li><li>{second}</li></ul>
    </section>
    <section class="card" data-service-deliverables>
      <h2 class="h2">{ru?'Что получите на выходе':'What you will get'}</h2>
      <p>{deliverables}</p>
    </section>
    {steps.length > 0 && <section class="card" data-service-steps>
      <h2 class="h2">{ru?'Как проходит работа':'How the work proceeds'}</h2>
      <ol class="list">
        {steps.map(([heading,body]) => <li><strong>{heading}.</strong> {body}</li>)}
      </ol>
    </section>}
    <section>
      <h2 class="h2">{ru?'Примеры выполненных работ':'Relevant case studies'}</h2>
      <div class="grid">
        {examples.map(p => <article class="card">
          <h3 class="h2"><a href={base+'/showcase/'+p.slug+(ru?'/':'/en/')}>{p.name}</a></h3>
          <p class="muted">{caseHighlights[p.slug]?.[ru?'ru':'en'] ?? p.description}</p>
        </article>)}
      </div>
      <p><a class="btn btn--ghost" href={base+'/showcase'+localeSuffix+'?task='+encodeURIComponent(service.slug)}>{ru?'Открыть подборку в каталоге':'Open this collection in the case catalog'}</a></p>
    </section>
    {questions.length > 0 && <section class="card" data-service-questions>
      <h2 class="h2">{ru?'Вопросы перед началом работы':'Common questions before we start'}</h2>
      <dl class="service-questions">
        {questions.map(([question, answer]) => <div><dt>{question}</dt><dd>{answer}</dd></div>)}
      </dl>
    </section>}
    <section class="card">
      <h2 class="h2">{ru?'С чего начнём':'How to get started'}</h2>
      <p>{outcome}</p>
      <div class="btnrow">
        <a class="btn" href={enquiry.href} data-enquiry-email>{ru?'Открыть шаблон письма':'Open enquiry email template'}</a>
        <a class="btn btn--ghost" href={enquiry.telegramHref} data-enquiry-telegram>{ru?'Заявка в Telegram':'Enquire on Telegram'}</a>
      </div>
    </section>
    <section class="card" data-service-paths>
      <h2 class="h2">{ru?'Если задача немного другая':'If your project needs a different approach'}</h2>
      <ul class="list service-paths">
        {nextServices.map(item=><li>
          <a data-related-service={item.slug} href={base+'/services/'+item.slug+localeSuffix}>{item.title}</a>
          <p>{item.reason}</p>
        </li>)}
      </ul>
    </section>
    {guides.filter(guide=>guide.services.includes(service.slug)).map(guide=><section class="card">
      <h2 class="h2">{guide[ru?'ru':'en'].context}</h2>
      <p><a href={base+'/guides/'+guide.slug+localeSuffix}>{guide[ru?'ru':'en'].title}</a></p>
    </section>)}
  </div>
</Layout>
<style>
.service{display:grid;gap:16px;padding-block:16px 32px;max-width:960px}
.service .hero__summary{margin-bottom:1rem}
.service section>h2{margin-bottom:.75rem}
.service-questions{display:grid;gap:1rem;margin:0}
.service-questions dt{font-weight:700}
.service-questions dd{margin:.25rem 0 0}
.service-paths li+li{margin-top:.75rem}
.service-paths p{margin:.25rem 0 0}
</style>
