---
import Layout from '../../components/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { guides } from '../../content/guides.mjs';
import { createEnquiry } from '../../content/enquiry.mjs';

export function getStaticPaths() {
  return guides.flatMap(guide=>['ru','en'].map(lang=>({
    params:{slug:guide.slug+(lang==='en'?'/en':'')}, props:{lang,guide},
  })));
}

const {lang,guide}=Astro.props;
const ru=lang==='ru';
const copy=guide[ru?'ru':'en'];
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const suffix=ru?'/':'/en/';
const service=base+'/services/'+guide.primaryService+suffix;
const path=base+'/guides/'+guide.slug;
const alternates=[
  {id:'ru',label:'RU',href:path+'/',active:ru},
  {id:'en',label:'EN',href:path+'/en/',active:!ru},
];
const breadcrumbs=[
  {name:ru?'Главная':'Home',href:base+suffix},
  {name:copy.title},
];
const enquiry=copy.enquiry ? createEnquiry({
  lang,title:copy.action,url:new URL(Astro.url.pathname,Astro.site ?? Astro.url).href,
  kind:'guide',serviceSlug:guide.primaryService,customPrompts:copy.enquiry,
}) : null;
---
<Layout title={copy.title+(ru?' — Олег Тишин':' — Oleg Tishin')} description={copy.summary} lang={lang}
  section="guides" customLangLinks={alternates} breadcrumbs={breadcrumbs}>
  <article class="container buyer-guide">
    <Breadcrumbs lang={lang} items={breadcrumbs}/>
    <header class="card hero">
      <h1 class="hero__name">{copy.title}</h1>
      <p class="hero__summary">{copy.intro}</p>
      <p class="muted">{ru?'Олег Тишин, веб-разработчик':'Oleg Tishin, web developer'}</p>
    </header>
    <ol class="guide-steps">
      {copy.steps.map(([title,body])=><li class="card"><h2 class="h2">{title}</h2><p>{body}</p></li>)}
    </ol>
    <section class="card">
      <h2 class="h2">{ru?'Примеры из проектов':'Case studies'}</h2>
      <ul class="list">{copy.examples.map(([label,slug])=><li><a href={base+'/showcase/'+slug+suffix}>{label}</a></li>)}</ul>
    </section>
    <section class="card">
      <h2 class="h2">{ru?'Официальная документация':'Official documentation'}</h2>
      <ul class="list">{copy.sources.map((label,index)=><li><a href={guide.sourceUrls[index]}>{label}</a></li>)}</ul>
    </section>
    <section class="card">
      <h2 class="h2">{copy.action}</h2>
      <p>{copy.call}</p>
      <div class="btnrow">
        {enquiry && <a class="btn" href={enquiry.href} data-guide-enquiry>{copy.email}</a>}
        <a class:list={['btn',{'btn--ghost':enquiry}]} href={service}>{copy.serviceLabel}</a>
        <a class="btn btn--ghost" href="https://t.me/wporgru">{ru?'Обсудить в Telegram':'Discuss on Telegram'}</a>
      </div>
    </section>
  </article>
</Layout>
<style>
.buyer-guide{display:grid;gap:1rem;max-width:900px;padding-block:1rem 2rem}
.buyer-guide > :global(.breadcrumbs){margin:0}
.guide-steps{display:grid;gap:1rem;padding:0;margin:0;list-style-position:inside}
.guide-steps .h2{display:inline}
.guide-steps p{margin:.6rem 0 0}
</style>
